# Snap Builder AI — Environment Variables
# Copy this file to .env and fill in your values (never commit .env to git)

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...

# App
NODE_ENV=production
PORT=5000

# Sessions (generate a random string, e.g. `openssl rand -hex 32`)
SESSION_SECRET=your-random-session-secret-here

# App base URL (used for OAuth callback URLs)
APP_BASE_URL=https://myhandyman-ai-production.up.railway.app

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (https://developer.apple.com → Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID = Services ID (e.g. com.myhandyman.app)
# APPLE_TEAM_ID   = 10-char Team ID
# APPLE_KEY_ID    = Key ID of the Sign In with Apple private key
# APPLE_PRIVATE_KEY = Contents of the .p8 file (newlines as \n)
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email list integration (optional)
EMAIL_LIST_ENABLED=false
