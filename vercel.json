{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://myhandyman-ai-production.up.railway.app/api/:path*"
    },
    {
      "source": "/attached_assets/:path*",
      "destination": "https://myhandyman-ai-production.up.railway.app/attached_assets/:path*"
    }
  ]
}
